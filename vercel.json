{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{api.php,admin.php,store-config.php,merchant-images.php,product-identifiers.php,store-policies.php,store-pricing.php,blackcat-gateway.php,blackcat-test-charge.php,*-product-prices.json,certs/*.crt}"
    }
  },
  "routes": [
    {"src": "/admin\\.html", "status": 308, "headers": {"Location": "/admin.php"}},
    {"src": "/admin(?:\\.php)?", "dest": "/api/index.php?__store_route=/admin"},
    {"src": "/api(?:/(.*))?", "dest": "/api/index.php?__store_route=/api/$1"},
    {"src": "/merchant-feed\\.xml", "dest": "/api/index.php?__store_route=/merchant-feed.xml"},
    {"src": "/(?:.*\\.php|.*\\.py|.*\\.md|.*\\.ya?ml|.*\\.sqlite3?|.*\\.db|\\..*)(?:/.*)?", "status": 404},
    {"handle": "filesystem"},
    {"src": "/.*", "status": 404}
  ]
}
